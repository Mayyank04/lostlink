# ==============================================================================
# LOSTLINK 2.0 — ENVIRONMENT CONFIGURATION
# Cloud Computing Module IV PBL Project
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Backend Integration Boundary (Kubernetes Containerized REST API)
# In demo mode, leaving NEXT_PUBLIC_API_URL empty activates the client-side typed storage layer.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# University Multi-Tenant Configuration
NEXT_PUBLIC_DEFAULT_COLLEGE_ID=college-apex
NEXT_PUBLIC_ENABLE_CROSS_CAMPUS_SEARCH=true
NEXT_PUBLIC_DEMO_MODE=true

# Authentication / OIDC Configuration (Planned Backend Integration)
NEXT_PUBLIC_AUTH_PROVIDER=mock
NEXT_PUBLIC_OIDC_ISSUER_URL=https://auth.lostlink.org/realms/lostlink
NEXT_PUBLIC_OIDC_CLIENT_ID=lostlink-frontend

# File Storage Bucket (AWS S3 / MinIO / Google Cloud Storage on Kubernetes)
NEXT_PUBLIC_STORAGE_BUCKET_URL=https://storage.lostlink.org/public

# Deterministic Matching Engine Parameters
NEXT_PUBLIC_MIN_MATCH_THRESHOLD=35
NEXT_PUBLIC_HIGH_CONFIDENCE_THRESHOLD=75

