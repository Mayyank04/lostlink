# ==============================================================================
# LOSTLINK 2.0 — ENVIRONMENT TEMPLATE (.env.example)
# Cloud Computing Module IV PBL Project
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection String
# Local Native format: postgresql://<username>:<password>@localhost:5432/lostlink_dev?schema=public
# Docker Compose format: postgresql://postgres:postgres@localhost:5432/lostlink_dev?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lostlink_dev?schema=public"

# Authentication & Session Secrets (Argon2id + HTTP-only cookies)
AUTH_SECRET="generate_a_random_32_character_string_for_production"
SESSION_EXPIRY_DAYS=7
EVIDENCE_ENCRYPTION_KEY="generate_a_random_32_character_encryption_key_for_production"
NEXT_PUBLIC_DEMO_MODE=false # Set to 'true' only for local offline UI demonstration without backend

# Object Storage Configuration (local, s3, r2)
STORAGE_PROVIDER=local # 'local', 's3', or 'r2'
STORAGE_BUCKET_NAME=lostlink-media
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=https://media.lostlink.org

# Email Service (test, smtp, resend)
EMAIL_PROVIDER=test # 'test' logs verification link to server console for local development
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@lostlink.org"

# Deterministic Matching Parameters
MIN_MATCH_THRESHOLD=35
HIGH_CONFIDENCE_THRESHOLD=75
