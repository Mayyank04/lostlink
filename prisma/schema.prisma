// ==============================================================================
// LOSTLINK 2.0 — PRISMA SCHEMA DEFINITION
// Cloud Computing Module IV PBL Project
// Multi-College Lost & Found Architecture — Phase 3 Extended
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum CollegeStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserRole {
  STUDENT
  COLLEGE_MODERATOR
  COLLEGE_ADMIN
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum MembershipStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ItemReportType {
  LOST
  FOUND
}

enum ItemStatus {
  OPEN
  POTENTIAL_MATCH
  CLAIM_PENDING
  RESOLVED
  RETURNED
  CLOSED
}

enum ClaimStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  HANDOVER_PENDING
  RETURNED
  CANCELLED
  DISPUTED
  COMPLETED
}

enum HandoverStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum JobStatus {
  QUEUED
  LEASED
  RUNNING
  COMPLETED
  RETRY_PENDING
  FAILED
  CANCELLED
}

enum WorkerType {
  CAMPUS
  CLOUD_FALLBACK
}

// ------------------------------------------------------------------------------
// COLLEGE & CAMPUS HIERARCHY
// ------------------------------------------------------------------------------

model College {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  emailDomains String[]      // Array of officially approved domains, e.g. ["apex.edu"]
  logoUrl      String?
  city         String
  state        String
  country      String        @default("United States")
  primaryColor String        @default("#0F766E")
  status       CollegeStatus @default(ACTIVE)
  institutionType String?    @default("University")
  website      String?
  address      String?
  contactEmail String?
  contactPhone String?
  reviewNotes  String?
  isArchived   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  campuses         Campus[]
  memberships      CollegeMembership[]
  items            Item[]
  auditLogs        AuditLog[]
  matchingJobs     MatchingJob[]
  campusWorkerKeys CampusWorkerKey[]
  adminInvitations CollegeAdminInvitation[]
  moderationActions ModerationAction[]

  @@index([status])
  @@index([slug])
}

model Campus {
  id                 String           @id @default(cuid())
  collegeId          String
  name               String
  code               String
  addressLabel       String
  lostFoundDeskRoom  String           @default("Main Security / Desk")
  operatingHours     String           @default("Mon - Fri: 8:00 AM - 6:00 PM")
  contactEmail       String           @default("lostfound@campus.edu")
  status             String           @default("ACTIVE")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  college            College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  locations          CampusLocation[]
  items              Item[]

  @@unique([collegeId, code])
  @@index([collegeId])
}

model CampusLocation {
  id           String   @id @default(cuid())
  campusId     String
  name         String
  building     String
  floorLabel   String?
  locationType String   @default("building") // library, building, canteen, gym, etc.
  hasDesk      Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campus       Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  items        Item[]

  @@index([campusId])
  @@index([building])
}

// ------------------------------------------------------------------------------
// USER & MEMBERSHIP ARCHITECTURE
// ------------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          UserRole   @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  phone         String?
  department    String?
  gradYear      Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships              CollegeMembership[]
  reportedItems            Item[]                    @relation("UserReportedItems")
  claims                   Claim[]                   @relation("UserClaims")
  notifications            Notification[]
  sessions                 Session[]
  auditLogs                AuditLog[]                @relation("ActorAuditLogs")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("UserSentMessages")
  messageReports           MessageReport[]           @relation("UserReportedMessages")
  claimStatusActions       ClaimStatusHistory[]      @relation("ActorClaimStatusHistory")
  notificationPreference   NotificationPreference?
  moderationActions        ModerationAction[]        @relation("ActorModerationActions")

  @@index([email])
  @@index([role])
}

model CollegeMembership {
  id                 String           @id @default(cuid())
  userId             String
  collegeId          String
  studentIdentifier  String?          // Private student ID (never exposed publicly)
  verificationMethod String           @default("EMAIL_DOMAIN")
  status             MembershipStatus @default(VERIFIED)
  verifiedAt         DateTime?        @default(now())
  verifiedBy         String?          @default("SYSTEM")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  college            College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// ITEMS, MEDIA & PRIVATE EVIDENCE
// ------------------------------------------------------------------------------

model Item {
  id                  String          @id @default(cuid())
  reportNumber        String          @unique // e.g. "LL-2026-8812" or "FD-2026-3021"
  reporterId          String
  collegeId           String
  campusId            String
  locationId          String?
  locationBuilding    String
  locationSpecifics   String?
  type                ItemReportType  // LOST or FOUND (immutable)
  name                String
  category            String          // electronics, keys, bags, etc.
  brand               String?
  color               String
  secondaryColor      String?
  description         String
  occurredAt          DateTime
  reportedAt          DateTime        @default(now())
  status              ItemStatus      @default(OPEN)
  depositedWithOffice Boolean         @default(false)
  officeLocationNotes String?
  viewsCount          Int             @default(0)
  isArchived          Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  reporter            User            @relation("UserReportedItems", fields: [reporterId], references: [id], onDelete: Cascade)
  college             College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  campus              Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  location            CampusLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  images              ItemImage[]
  privateEvidence     PrivateItemEvidence?
  lostMatches         Match[]         @relation("LostItemMatches")
  foundMatches        Match[]         @relation("FoundItemMatches")
  claims              Claim[]
  handoverChallenges  HandoverChallenge[]
  conversations       Conversation[]
  matchingJobs        MatchingJob[]

  @@index([collegeId])
  @@index([campusId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([occurredAt])
  @@index([reportNumber])
}

model ItemImage {
  id          String   @id @default(cuid())
  itemId      String
  objectKey   String
  url         String
  contentType String   @default("image/jpeg")
  fileSize    Int      @default(0)
  visibility  String   @default("PUBLIC") // PUBLIC or PRIVATE_EVIDENCE
  createdAt   DateTime @default(now())

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model PrivateItemEvidence {
  id                String   @id @default(cuid())
  itemId            String   @unique
  encryptedEvidence String   // Serial snippet, lockscreen clues, secret markings in JSON/cipher
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item              Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------------------
// MATCHING & CLAIMS
// ------------------------------------------------------------------------------

model Match {
  id          String   @id @default(cuid())
  lostItemId  String
  foundItemId String
  collegeId   String?
  ruleVersion Int      @default(1)
  score       Int      // 0 to 100
  explanation String   // JSON breakdown of dimensions
  status      String   @default("ACTIVE") // ACTIVE, DISMISSED, CLAIMED, RESOLVED, EXPIRED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  lostItem    Item     @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItem   Item     @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)

  @@unique([lostItemId, foundItemId])
  @@index([lostItemId])
  @@index([foundItemId])
  @@index([collegeId])
  @@index([score])
  @@index([status])
}

model Claim {
  id                       String               @id @default(cuid())
  referenceNumber          String               @unique // e.g. "CLM-2026-4419"
  itemId                   String
  claimantId               String
  linkedLostItemId         String?
  privateEvidenceReference String               // JSON answers to ownership questions
  additionalProofNotes     String?
  status                   ClaimStatus          @default(PENDING)
  reviewedBy               String?
  reviewedAt               DateTime?
  handoverCode             String?              // 6-digit OTP exchange code
  handoverLocation         String?
  claimantConfirmed        Boolean              @default(false)
  finderConfirmed          Boolean              @default(false)
  rejectionReason          String?
  timeline                 String               @default("[]") // JSON array of audit events
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  item                     Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimant                 User                 @relation("UserClaims", fields: [claimantId], references: [id], onDelete: Cascade)
  statusHistory            ClaimStatusHistory[]
  handoverChallenge        HandoverChallenge?
  conversations            Conversation[]

  @@index([itemId])
  @@index([claimantId])
  @@index([status])
}

model ClaimStatusHistory {
  id         String      @id @default(cuid())
  claimId    String
  fromStatus ClaimStatus
  toStatus   ClaimStatus
  actorId    String
  reasonCode String?
  notes      String?
  createdAt  DateTime    @default(now())

  claim      Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor      User        @relation("ActorClaimStatusHistory", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([actorId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// HANDOVER & RETURN VERIFICATION
// ------------------------------------------------------------------------------

model HandoverChallenge {
  id                 String         @id @default(cuid())
  claimId            String         @unique
  itemId             String
  codeHash           String         // SHA-256 hash of 6-digit OTP
  qrTokenHash        String?        // SHA-256 hash of secure QR verifier string
  status             HandoverStatus @default(PENDING)
  verificationMethod String         @default("OTP") // OTP, QR, MANUAL_MODERATOR
  expiresAt          DateTime
  confirmedByUserId  String?
  confirmedAt        DateTime?
  handoverLocation   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  claim              Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  item               Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([itemId])
  @@index([status])
  @@index([expiresAt])
}

// ------------------------------------------------------------------------------
// MESSAGING & COMMUNICATIONS
// ------------------------------------------------------------------------------

model Conversation {
  id           String                    @id @default(cuid())
  claimId      String?
  itemId       String?
  title        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  claim        Claim?                    @relation(fields: [claimId], references: [id], onDelete: SetNull)
  item         Item?                     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([claimId])
  @@index([itemId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime        @default(now())

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User            @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  reports        MessageReport[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageReport {
  id         String   @id @default(cuid())
  messageId  String
  reporterId String
  reason     String
  status     String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt  DateTime @default(now())

  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User     @relation("UserReportedMessages", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([reporterId])
}

// ------------------------------------------------------------------------------
// NOTIFICATIONS, PREFERENCES & OUTBOX
// ------------------------------------------------------------------------------

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String   // match_found, strong_match, claim_received, claim_approved, new_message, handover_ready, item_returned
  title      String
  message    String
  resourceId String?
  linkUrl    String?
  metadata   String?  // JSON context
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  emailMatches   Boolean  @default(true)
  emailClaims    Boolean  @default(true)
  emailMessages  Boolean  @default(true)
  emailHandovers Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String    // NOTIFICATION, EMAIL, MATCH_RECALCULATION
  payload     String    // JSON payload
  status      String    @default("PENDING") // PENDING, PROCESSED, FAILED
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([eventType])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// PHASE 5 — DISTRIBUTED HYBRID MATCHING & CAMPUS EDGE KEYS
// ------------------------------------------------------------------------------

model MatchingJob {
  id               String         @id @default(cuid())
  collegeId        String
  reportId         String         // ID of the item report triggering the matching
  itemType         ItemReportType // LOST or FOUND
  ruleVersion      String         @default("v2.0-deterministic")
  status           JobStatus      @default(QUEUED)
  attempts         Int            @default(0)
  maxAttempts      Int            @default(3)
  assignedWorkerId String?
  workerType       WorkerType?
  leasedAt         DateTime?
  leaseExpiresAt   DateTime?
  payload          String         // JSON payload containing sanitized item fields needed for matching
  result           String?        // JSON result summary (matched items, scores, explanation)
  error            String?
  createdAt        DateTime       @default(now())
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt

  college          College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  item             Item           @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([collegeId])
  @@index([reportId])
  @@index([leaseExpiresAt])
  @@index([createdAt])
}

model CampusWorkerKey {
  id              String   @id @default(cuid())
  workerId        String   @unique // e.g., "worker-apex-edge-01"
  collegeId       String?  // Scoped college ID, or null for platform-wide/multi-college worker
  name            String   // e.g. "Apex Engineering Lab Edge Node"
  apiKeyHash      String   // SHA-256 hash of API key
  keyPrefix       String   // e.g. "ll_camp_" + first 6 chars for identification
  status          String   @default("ACTIVE") // ACTIVE, REVOKED, SUSPENDED
  lastHeartbeatAt DateTime?
  lastIpAddress   String?
  metrics         String?  // JSON metrics (uptime, cpu, memory, jobsCompleted)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  college         College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([status])
  @@index([collegeId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  collegeId    String?
  action       String   // CREATE_REPORT, APPROVE_CLAIM, REJECT_CLAIM, DELETE_REPORT, HANDOVER_CONFIRMED, etc.
  resourceType String   // ITEM, CLAIM, USER, COLLEGE, HANDOVER, MESSAGE
  resourceId   String?
  metadata     String?  // JSON context (sanitized; no secrets/passwords)
  ipAddress    String?
  timestamp    DateTime @default(now())

  actor        User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  college      College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([collegeId])
  @@index([action])
  @@index([timestamp])
}

// ------------------------------------------------------------------------------
// SESSIONS & AUTH TOKENS
// ------------------------------------------------------------------------------

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // email
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([identifier])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ------------------------------------------------------------------------------
// SUPER ADMIN & MULTI-COLLEGE ONBOARDING GOVERNANCE
// ------------------------------------------------------------------------------

model CollegeApplication {
  id              String   @id @default(cuid())
  collegeName     String
  slug            String   @unique
  institutionType String   @default("University")
  website         String?
  emailDomains    String[]
  country         String   @default("United States")
  state           String
  city            String
  address         String?
  contactEmail    String?
  contactPhone    String?
  initialCampus   String   @default("Main Campus")
  applicantName   String
  applicantEmail  String
  applicantRole   String   // e.g. "Dean of Students", "Director of Campus Safety"
  notes           String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewNotes     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([slug])
  @@index([applicantEmail])
}

model CollegeAdminInvitation {
  id         String   @id @default(cuid())
  collegeId  String
  email      String
  token      String   @unique
  role       UserRole @default(COLLEGE_ADMIN)
  invitedBy  String
  status     String   @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())

  college    College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([email])
  @@index([token])
  @@index([status])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // String or serialized JSON
  description String?
  isPublic    Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model ModerationAction {
  id         String   @id @default(cuid())
  actorId    String
  collegeId  String?
  targetType String   // ITEM, USER, CLAIM, MESSAGE
  targetId   String
  action     String   // FLAG, HIDE, RESTORE, SUSPEND, WARN
  reason     String
  metadata   String?  // JSON context
  createdAt  DateTime @default(now())

  actor      User     @relation("ActorModerationActions", fields: [actorId], references: [id], onDelete: Cascade)
  college    College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([collegeId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

