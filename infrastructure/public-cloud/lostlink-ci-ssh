#!/bin/bash
set -euo pipefail

if [[ ! ${SSH_ORIGINAL_COMMAND-} =~ ^deploy\ ([a-f0-9]{40})$ ]]; then
  printf '%s\n' 'This SSH key only accepts deploy <40-character commit SHA>.' >&2
  exit 64
fi

printf '%s\n' "${BASH_REMATCH[1]}" |
  /usr/bin/env -i PATH=/usr/bin:/bin /usr/bin/sudo -n /usr/local/sbin/lostlink-ci-release
