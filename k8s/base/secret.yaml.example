apiVersion: v1
kind: Secret
metadata:
  name: lostlink-secrets
  namespace: lostlink
  labels:
    app.kubernetes.io/name: lostlink
    app.kubernetes.io/component: credentials
type: Opaque
stringData:
  POSTGRES_USER: "lostlink"
  POSTGRES_PASSWORD: "CHANGE_ME_IN_PRODUCTION"
  POSTGRES_DB: "lostlink"
  DATABASE_URL: "postgresql://lostlink:CHANGE_ME_IN_PRODUCTION@postgres:5432/lostlink?schema=public"
  NEXTAUTH_SECRET: "CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
