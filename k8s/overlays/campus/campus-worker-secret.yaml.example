apiVersion: v1
kind: Secret
metadata:
  name: lostlink-campus-worker-secret
  namespace: lostlink-campus
  labels:
    app.kubernetes.io/name: lostlink-campus-worker
    app.kubernetes.io/component: worker
type: Opaque
stringData:
  # Machine-to-machine key generated on cloud VPS via:
  # npm run cli:issue-worker-key -- --college <college-id> --label <worker-name>
  CAMPUS_WORKER_KEY: "ll_camp_live_REPLACE_WITH_YOUR_BEARER_TOKEN"
